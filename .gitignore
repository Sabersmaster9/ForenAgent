# ============================================================
# ForenAgent 1.0 — 版本控制边界
#
# 原则：仓库只收「代码 + 规则文本 + 文档」。
#       案卷材料、运行输出、模型权重、原始数据一律留在本机。
# ============================================================

# ---------- 案卷材料（含身份证、病历等个人信息，严禁外传）----------
database/
files/知识库/知识库_输入/
files/知识库/语料/
# 参考鉴定意见书：姓名只做部分脱敏，仍含身份证号、住址、亲属姓名、住院号，
# 属于真实卷宗，只留本机，不进任何远端。
files/知识库/知识库_案例/
# 真实意见书的 Word 版式样本，同样含身份证号/住址/姓名，仅供本机对照排版。
files/知识库/格式示例/

# ---------- 运行输出（可由流水线重跑再生）----------
test_result/
runs/
outputs/
logs/
# 偶尔会把某份跑出来的意见书临时丢在仓库根目录上做对照，里面是真实当事人信息。
# 只挡根目录这一层，不影响 deploy/ 等处的正式文件。
/鉴定意见书.docx
/鉴定意见书.md
/AI审计报告.md

# ---------- 模型权重与大二进制 ----------
models/*.pt
*.pt
*.pth
*.onnx
*.pkl
*.npy
*.npz
*.zip
*.rar
*.7z

# ---------- 法规标准 PDF（正文 Markdown 才是运行时依赖）----------
files/知识库/知识库_条例/*.pdf

# ---------- 本地密钥与环境 ----------
.env
.env.*
!.env.example

# ---------- Python ----------
.venv/
venv/
__pycache__/
*.py[cod]

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------- 图片：避免工具递归扫描 ----------
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff

# ---------- 工具过程目录 ----------
.claude/
.claude_tmp_*/
.codex_tmp/
.codex-tmp/
_qa*/
tmp/
temp/
